      "source": "CL1",
      "target": "PR1",
      "weight": 1.0,
      "capacity": 600.0,
      "latency": 2.0,
      "is_directed": false,
      "metadata": { "label": "Primary Ingress Link" }
    },
    {
      "edge_id": "E_PR1_CS1",
      "source": "PR1",
      "target": "CS1",
      "weight": 1.0,
      "capacity": 600.0,
      "latency": 2.0,
      "is_directed": false,
      "metadata": { "label": "Primary Core Uplink" }
    },
    {
      "edge_id": "E_CL1_BR1",
      "source": "CL1",
      "target": "BR1",
      "weight": 2.5,
      "capacity": 500.0,
      "latency": 6.0,
      "is_directed": false,
      "metadata": { "label": "Backup Ingress Link (Higher Metric)" }
    },
    {
      "edge_id": "E_BR1_CS1",
      "source": "BR1",
      "target": "CS1",
